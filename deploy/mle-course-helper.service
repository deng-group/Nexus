[Unit]
Description=Wendao course AI widget API (MLE4217/5219)
After=network.target

[Service]
Type=simple
User=mlehelper
Group=mlehelper
# The course workspace (wendao.toml, concepts.json, build/). API keys come from the EnvironmentFile.
WorkingDirectory=/srv/mle-course-helper/workspace
Environment=WENDAO_WORKSPACE=/srv/mle-course-helper/workspace
EnvironmentFile=/etc/mle-course-helper.env
ExecStart=/srv/mle-course-helper/wendao/.venv/bin/gunicorn "wendao.web.widget:create_app()" --bind 127.0.0.1:5055 --workers 2 --threads 4 --timeout 180 --access-logfile -
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
