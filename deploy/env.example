# Copy this file to /etc/mle-course-helper.env on the server.
# Keep real API keys out of git.

# Flask/Gunicorn
PORT=5055
PYTHONUNBUFFERED=1
HF_HOME=/srv/mle-course-helper/wendao/.cache/huggingface

# The model is chosen in the workspace's wendao.toml ([model]). Put the API key
# here. Anything set here overrides wendao.toml.
# LLM_PROVIDER=anthropic

# Optional answer temperature (default 0.2). Use "none" for models that only
# accept their default, such as OpenAI's reasoning models.
# LLM_TEMPERATURE=0.2

# Anthropic, or any server that speaks the Anthropic Messages API.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_AUTH_TOKEN=replace-me
# ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI, or any OpenAI-compatible server (DeepSeek, OpenRouter, vLLM, Ollama, ...).
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=replace-me
# OPENAI_MODEL=gpt-4.1-mini

# Gemini
# GEMINI_API_KEY=replace-me
# GEMINI_MODEL=gemini-2.5-flash
